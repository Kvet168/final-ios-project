<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the engine starts: ocean blue with the WAYFARER compass, so the first frame is never white. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/wf_primary_deep</item>
        <item name="android:navigationBarColor">@color/wf_primary_deep</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/wf_page</item>
    </style>
</resources>
