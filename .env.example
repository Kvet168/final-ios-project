# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.
#
# AI for the trip planner and travel guide. One key is enough:
#   - Google Gemini (free tier): https://aistudio.google.com/apikey   -> key starts with "AIza"
#   - Anthropic Claude:           https://console.anthropic.com/       -> key starts with "sk-ant-"
# The provider is detected from the key; leave AI_MODEL empty for the default model.
AI_PROVIDER_API_KEY=
AI_PROVIDER=auto
AI_MODEL=
AI_RATE_LIMIT_PER_MINUTE=20

# Sign-in (Firebase). The defaults in docker-compose.yml are the project this app is configured for; override only for another project.
# FIREBASE_PROJECT_ID=travel-app-5b220
# GOOGLE_CLIENT_ID=
